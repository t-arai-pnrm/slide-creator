---
/**
 * 1 つのデッキを 1 つの HTML にする骨組み。子に Slide を並べる。
 * HTML としては、すべてのスライドを縦に並べてスクロールで読む形を、JavaScript なしで成り立たせる。
 * 1 枚ずつ表示する発表の表示と、発表者ビューは、src/scripts/deck.ts が属性を書き換えて作る。
 */
import '@/styles/index.css'
import DeckControls from '@/components/DeckControls.astro'
import PresenterTimer from '@/components/PresenterTimer.astro'
import { COLOR_SCHEME_STORAGE_KEY, COLOR_SCHEMES } from '@/scripts/theme'

interface Props {
	/** デッキの題名。<title> と、文書の h1 に使う */
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<!-- viewport-fit=cover は、ノートの面と枠の外の色を、ノッチやホームインジケーターのある端末でも画面の端まで塗るため（DESIGN.md の「画面の端」） -->
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<!-- 初期値は OS の設定にかかわらずライトにする（発表者の OS がダークのまま映す失敗を防ぐため）。切り替えはこの content を書き換える -->
		<meta name="color-scheme" content="light only" />
		<!--
			保存したテーマを、最初の描画の前に当てる。モジュールの script は描画のあとに動くので、ライトで描いてからダークに替わり、ちらつくため。
			書き換える color-scheme の meta より後ろ、スタイルシートの link より前に置く。link の後ろに置くと、Google Fonts の CSS が届くまで実行が待たされる。
			Astro が埋め込む CSS は head の末尾に入り、この script より後ろになるので、.markuplintrc の head-element-order は script を link と style より前に並べる順にしている。
			localStorage は、プライベートブラウズや保存を禁じた設定で例外になるので、そのときは初期値のまま描く
		-->
		<script is:inline define:vars={{ storageKey: COLOR_SCHEME_STORAGE_KEY, schemes: COLOR_SCHEMES }}>
			try {
				const saved = localStorage.getItem(storageKey)
				if (schemes.includes(saved)) {
					document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', saved)
				}
			} catch {
				// 初期値のライトで描く
			}
		</script>
		<!-- 和文の Noto Sans JP（400、700）は、DESIGN.md の決めごとで、欧文と違い埋め込まず Google Fonts から読み込む。通信できない場所では OS の書体で出る -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" />
		<!--
			コンポーネントの style 要素がどの順で出力されても、レイヤーの順番がこの宣言で決まるよう、Astro が head の末尾に足す CSS より前に置く。
			Google Fonts の CSS は @font-face だけでレイヤーを使わないので、その後ろでよい
		-->
		<style is:inline>
			@layer tokens, reset, base, vendors, compositions, pages, components, patterns, utilities;
		</style>
	</head>
	<body>
		<!-- 発表者ビューで画面の上の端に置くので、読む順もスライドより前にする -->
		<PresenterTimer />
		<main class="deck">
			<h1 class="_title | -visually-hidden">{title}</h1>
			<slot />
		</main>
		<!-- 操作の部分の置き場所を決める Outer。位置はこの要素に書き、DeckControls のルートには書かない -->
		<div class="_controls">
			<DeckControls />
		</div>
		<script>
			import { initDeck } from '@/scripts/deck'

			initDeck()
		</script>
	</body>
</html>

<style>
	@layer components {
		/*
		 * デッキの表示（data-view）とノートの表示（data-notes）は main.deck にあり、
		 * 経過時間と操作の部分（を包む ._controls）は main.deck の外の兄弟にある。そこで、置く側の body が :has() で自分の状態として受け、
		 * 子が読むフラグと値を body で宣言する。子の配置のネストは、それを var() とスタイルクエリで読むだけにする
		 * （is-for-ancestor-context、nest-own-states-only、placement-via-public-flag）。
		 * スタイルクエリは親の値を問い合わせる。経過時間と ._controls の親は body で、スライドの親の .deck は body から値を継承する。
		 * body の内部プロパティは .deck と .slide にも継承されるので、Slide.astro の内部プロパティと重ならない名前にする
		 */
		body {
			/* 発表の表示か、発表者ビューか。経過時間、操作の部分、スライドの配置が読む */
			--_is-present-view: --false;
			--_is-presenter-view: --false;

			/*
			 * 発表の表示で、操作の部分を今のスライドの枠の右上に重ねるための値。
			 * 操作の部分は main.deck の外にあり、同じグリッドのエリアに重ねられないので、
			 * 画面に固定し、Slide.astro と同じ式で枠の右上の位置を求める。
			 * 枠の比とノートの領域の割合は、Slide.astro と同じトークンを使う（share-look-with-tokens）。
			 * 枠を収める高さは、ふだんは画面の高さで、ノートを出したときはその残り
			 */
			--_controls-stage-block-size: 100svb;

			/*
			 * 枠の幅と高さ。幅は、画面に固定した要素の % が画面の幅になる inset-inline-end でだけ使う。
			 * 高さは上からの位置に使うので、画面の幅を svi で表す。スクロールバーの幅を取る環境では、
			 * 枠の高さより数 px 大きく見積もる。比は「16 / 9」のまま置き換わるので、割るときは括弧で包む
			 */
			--_controls-frame-inline-size: min(100%, var(--_controls-stage-block-size) * var(--frame--aspect-ratio));
			--_controls-frame-block-size: min(var(--_controls-stage-block-size), 100svi / (var(--frame--aspect-ratio)));

			/* 枠の上の辺と右の辺から離す距離（DESIGN.md の「操作の部分」） */
			--_controls-inset: 1rem;

			&:has(> .deck[data-view='present']) {
				--_is-present-view: --true;
			}

			&:has(> .deck[data-view='present'][data-notes='shown']) {
				--_controls-stage-block-size: calc(100svb * (1 - var(--notes--share)));
			}

			/*
			 * 発表者ビューでは、経過時間、デッキ、操作の部分を、この順に画面の高さ（100svb）に収める。
			 * デッキの行を残りの高さにし、ノートの領域を操作の部分のすぐ上まで届かせる（DESIGN.md の「発表者ビュー」）。
			 * 行の最小を 0 にし、長いノートでデッキが画面の高さを超えないようにする（ノートは領域の中でスクロールする）。
			 * hidden の要素はグリッドのアイテムにならないので、間は row-gap で空ける（gap-over-child-margin）。
			 * kiso.css の body の min-block-size（100dvb）は残す。dvb は svb 以上なので、画面に収まる高さは変わらない
			 */
			&:has(> .deck[data-view='presenter']) {
				--_is-presenter-view: --true;

				/* 操作の部分は画面の下の端にあるので、ツールチップをボタンの上に出す（DESIGN.md の「発表者ビュー」）。公開プロパティで、包む側から渡す */
				--deck-controls--tooltip-side: --block-start;

				display: block grid;
				grid-template-rows: auto minmax(0, 1fr) auto;
				row-gap: 1rem;
				block-size: 100svb;

				/*
				 * 経過時間、デッキ、操作の部分を、画面の端から 1rem 離す。端からの余白は置き場所で決まるので、
				 * 子のルートではなく、置く側の body の内側の余白で取る
				 * （no-external-layout-on-root、parent-owns-child-placement、margin-collapse-padding-for-inner-space）。
				 * 画面の端に接する余白なので、辺ごとにセーフエリアと比べて大きいほうにする（safe-area-combine-with-max）。
				 * セーフエリアは物理的な辺なので、上、右、下、左の順の一括指定で書く。
				 * 面は body の背景（文書のルートと同じ色）なので、body の内側の余白で取っても、色が途切れた帯はできない
				 */
				padding: max(1rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right))
					max(1rem, env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
			}

			/*
			 * 操作の部分の置き場所は置く側のこのファイルが決め、包む Outer の ._controls に書く
			 * （parent-owns-child-placement、no-external-layout-on-root）。
			 * DeckControls のルートは、ハイライトとツールチップの包含ブロックにするため position: relative を持つ。
			 * ルートを選んで position を書くと、同じレイヤーの中で詳細度の競争になるので、ルートは選ばない
			 * （order-by-layer-not-specificity）。帯の幅は中身の幅のままなので、Outer の大きさは帯と同じになる
			 */
			& > ._controls {
				/*
				 * 発表の表示では、枠の右上の角の内側に置く。右下にはスライドのページ番号があり、重なるため。
				 * 画面に固定した要素からは枠の位置を参照できないので、枠が収める高さの中で上下の中央に、
				 * 画面の左右の中央にあることから、上の辺と右の辺の位置を枠の大きさで求める。
				 * 画面の端から浮かせて置くので、セーフエリアに --_controls-inset を足した位置と比べ、大きいほうにする
				 * （safe-area-combine-with-max、safe-area-fixed-bottom の補足）。セーフエリアは物理的な辺なので、上と右で比べる
				 */
				@container style(--_is-present-view: --true) {
					position: fixed;
					inset-block-start: max(
						(var(--_controls-stage-block-size) - var(--_controls-frame-block-size)) / 2 + var(--_controls-inset),
						calc(env(safe-area-inset-top) + var(--_controls-inset))
					);
					inset-inline-end: max(
						(100% - var(--_controls-frame-inline-size)) / 2 + var(--_controls-inset),
						calc(env(safe-area-inset-right) + var(--_controls-inset))
					);
				}

				/* 発表者ビューでは、画面の下の端の左に置き、帯の幅を中身の幅のままにする（DESIGN.md の「発表者ビュー」） */
				@container style(--_is-presenter-view: --true) {
					justify-self: start;
				}
			}

			/*
			 * 発表者ビューの経過時間のツールチップは、下のデッキに重なる。デッキは HTML の順で後ろにあり、
			 * 大きさのコンテナとして重なりの区切りを作るので、木の順のままではツールチップが隠れる。
			 * 経過時間はグリッドのアイテムなので、position を足さずに z-index で前に出す
			 * （z-index-absolute-root-relative-inside、z-index-on-items-without-position）
			 */
			& > :global(.presenter-timer) {
				@container style(--_is-presenter-view: --true) {
					z-index: var(--z--timer);
				}
			}
		}

		.deck {
			/*
			 * 紙に出すときは、画面の配色にかかわらずライトにする。
			 * color は :root で画面の配色のまま計算されて継承されるので、
			 * ここで指定し直す（redeclare-colors-with-color-scheme）
			 */
			@media print {
				color-scheme: light;
				background-color: var(--background--base);
				color: var(--foreground--base);
			}

			/*
			 * 縦に並べる形では、最初のスライドの枠を、画面の上の端からセーフエリアの分だけ下げる（DESIGN.md の「画面の端」）。
			 * いつもの余白は 0 で、セーフエリアと比べる（safe-area-combine-with-max）。
			 * 枠の外の面は文書のルートと同じ色なので、デッキの内側の余白で空けても、色が途切れた帯はできない。
			 * 最後のスライドの下は、ノートの面を画面の端まで塗るため、Slide.astro の側で空ける
			 */
			&:not([data-view]) {
				padding-block-start: max(0px, env(safe-area-inset-top));
			}

			/*
			 * 発表の表示。表示するスライドは 1 枚だけなので、画面の高さの中で上下の中央に置く。
			 * ノートを出したときは、スライドが画面の高さを占め、その中で枠とノートの領域に分かれる（Slide.astro）
			 */
			&[data-view='present'] {
				display: block grid;
				align-content: center;
				min-block-size: 100svb;

				/* 横のスワイプはスクリプトが受け、縦のスクロールとピンチでの拡大はブラウザに残す（no-global-touch-action-none） */
				touch-action: pan-y pinch-zoom;
			}

			/*
			 * 発表者ビュー。左の上に今のスライドの枠を大きく、左の下に前と次のスライドを小さく横に並べ、
			 * 右に今のスライドのノートを上から下まで置く（DESIGN.md の「発表者ビュー」）。
			 * 今のスライドは全体（--stage）に広げ、その中の枠とノートを subgrid で --frame と --notes に置く（Slide.astro）。
			 * 最初のスライドには前が、最後のスライドには次がなく、その場所は空く。
			 *
			 * 前と次を今のスライドの下に半分ずつ並べるため、左を 2 列に分ける。左と右（ノート）は画面の幅を半分ずつ使う（DESIGN.md）。
			 * 上の段を下の段の 2 倍の高さにするのは、前と次が今のスライドの半分の幅で、枠の高さも半分になるため。
			 * デッキの高さは body のグリッドで決まり（経過時間と操作の部分の残り）、ノートはその高さいっぱいに広がる。
			 * 枠やノートの中身で行が広がって、body の行を超えないよう、行の最小を 0 にする。
			 * 列の最小は、global.css の全称セレクタの min-inline-size: 0 で 0 になっている（fr-without-minmax-zero）。
			 *
			 * 枠の幅は列の幅で決まるが、画面が横に長いと、枠の高さが行の高さを超える。
			 * そこで、デッキを大きさのコンテナにし、各スライドに、枠を収める高さとして行の高さを cqb で渡す。
			 * 式の 2 / 3 と 1 / 3 は、上の行の 2fr と 1fr にそろえる。cqb は渡した先の枠で、このデッキの高さに対して解決される
			 */
			&[data-view='presenter'] {
				--_gap: 1rem;

				/* 今のスライドと、前と次のスライドに渡す、枠を収める高さ */
				/* stylelint-disable-next-line unit-disallowed-list -- デッキの高さが確定している大きさのコンテナなので、cqb が働く */
				--_current-stage-block-size: calc((100cqb - var(--_gap)) * 2 / 3);
				/* stylelint-disable-next-line unit-disallowed-list -- デッキの高さが確定している大きさのコンテナなので、cqb が働く */
				--_adjacent-stage-block-size: calc((100cqb - var(--_gap)) / 3);

				/* stylelint-disable-next-line declaration-property-value-disallowed-list -- 高さは body のグリッドの行で確定しているため（no-container-type-size の例外。上のコメント） */
				container: --deck / size;
				display: block grid;
				reading-flow: grid-rows;
				grid-template:
					[--stage-start] '--frame --frame --notes' minmax(0, 2fr)
					'--prev --next --notes' minmax(0, 1fr) [--stage-end]
					/ [--stage-start] 1fr 1fr 2fr [--stage-end];
				gap: var(--_gap);
			}

			/* 発表者ビューでの、今、前、次のスライドの置き場所と、枠を収める高さ（Slide.astro の公開プロパティ） */
			& > :global(.slide[data-slide='current']) {
				@container style(--_is-presenter-view: --true) {
					--slide--stage-block-size: var(--_current-stage-block-size);

					grid-area: --stage;
				}
			}

			& > :global(.slide[data-slide='prev']) {
				@container style(--_is-presenter-view: --true) {
					--slide--stage-block-size: var(--_adjacent-stage-block-size);

					grid-area: --prev;
				}
			}

			& > :global(.slide[data-slide='next']) {
				@container style(--_is-presenter-view: --true) {
					--slide--stage-block-size: var(--_adjacent-stage-block-size);

					grid-area: --next;
				}
			}
		}
	}
</style>
