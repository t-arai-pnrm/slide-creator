---
/**
 * 発表の表示、発表者ビュー、縦に並べて読む形で使う操作の部分（進み具合とボタン）。src/scripts/deck.ts が動かす。
 * JavaScript が動かない環境では使えないので、hidden で出力し、スクリプトが動いたときに外す。
 * 縦に並べて読む形では、全画面と発表者ビューのボタンをスクリプトが hidden にする。
 *
 * ボタンはアイコンだけを見せ、名前（「ノート」など）は見えない文字でボタンに持たせる。アイコンは飾りとして読み上げから隠す。
 * キーは aria-keyshortcuts で伝え、名前に含めない。名前に含めると「ノート N」と読まれ、ショートカットだと分からないため。
 * aria-keyshortcuts のキーの名前は KeyboardEvent.key の値で書く。
 *
 * アイコンだけでは名前もキーも分からないので、各ボタンの中に、名前とキーを見せるツールチップを置く。
 * title 属性は使わない。ブラウザのツールチップは出るまでに待たされ、キーボードのフォーカスでは出ず、見た目も変えられないため。
 * ツールチップの文字は見えない名前と重なるので、aria-hidden で読み上げから外し、名前とキーが二重に読まれないようにする。
 *
 * ホバーかフォーカスしたボタンの下の面（ハイライト）は、ボタンごとに作らず、帯の擬似要素（::before）で 1 枚だけ描く。
 * CSS がアンカーポジショニングで、そのボタンの位置と大きさに合わせて動かす。どちらの組のボタンも相手にできるよう、組（menu）ではなく帯に描く。
 * 見た目だけの飾りなので、要素を置かず、読み上げにも出ない。
 *
 * 矢印キーでボタンの間を移る作り（role="toolbar"）にはしない。左右の矢印キーはスライドの移動に使うため。ボタンの間は Tab で移る。
 * 切り替えのボタンの aria-pressed は、スクリプトが今の状態に合わせて書き換える。
 * テーマのボタンは、「テーマ」のままでは押した状態がライトとダークのどちらを指すか分からないので、押した状態がダークを表すよう「ダーク」と名付ける。
 *
 * 文字は枠に比例させず、rem の control のスタイルで書く。置き場所（発表の表示で枠の右上に重ね、縦に並べて読む形で画面の下の中央に固定する）は、
 * 置く側の Deck.astro が決める。Deck.astro は、縦に並べて読む形の最後のスライドの下を空けるため、帯の高さを DESIGN.md の値から求めている。
 * 帯の内側の余白、枠、ボタンの大きさ、押せる部分の大きさ、進み具合の線を変えたら、Deck.astro の式も変える。
 *
 * @prop {number} [--deck-controls--progress=0] 進み具合の割合（0 より大きく 1 以下）。スクリプトが文書のルート（html）に書き、継承で受ける
 * @prop {--block-start|--block-end} [--deck-controls--tooltip-side=--block-end] ツールチップをボタンの上（--block-start）と下（--block-end）のどちらに出すか。
 *   置く側が、帯の置き場所に合わせて渡す（発表者ビューと縦に並べて読む形では帯を画面の下の端に置くので --block-start）
 */
import Icon from '@/components/Icon.astro'
---

<section class="deck-controls" aria-label="発表の操作" hidden>
	<!-- 移動したときに、今の位置を読み上げる -->
	<!-- 画面では枠の右下のページ番号と重複するので、読み上げのためだけに残す -->
	<p class="_position | -visually-hidden" aria-live="polite">
		<span class="-visually-hidden">スライド</span>
		<span class="_current" data-deck-current>1</span> / <span class="_total" data-deck-total></span>
	</p>
	<!-- 進み具合の線。割合は、文書のルート（html）の --deck-controls--progress（0 から 1）で渡す。数は上の文字で伝えるので、読み上げない -->
	<div class="_progress-line" aria-hidden="true"></div>
	<!-- 移動と表示の切り替えは、操作の種類が違うので、別の組（menu）に分ける -->
	<div class="_buttons">
		<menu aria-label="移動">
			<li>
				<button type="button" data-action="prev" aria-keyshortcuts="ArrowLeft PageUp Shift+Space">
					<Icon name="chevron-left" /><span class="-visually-hidden">前へ</span>
					<span class="_tooltip" aria-hidden="true">前へ<kbd>←</kbd></span>
				</button>
			</li>
			<li>
				<button type="button" data-action="next" aria-keyshortcuts="ArrowRight PageDown Space">
					<Icon name="chevron-right" /><span class="-visually-hidden">次へ</span>
					<span class="_tooltip" aria-hidden="true">次へ<kbd>→</kbd></span>
				</button>
			</li>
		</menu>
		<menu aria-label="表示の切り替え">
			<li>
				<button type="button" data-action="notes" aria-keyshortcuts="N" aria-pressed="false">
					<Icon name="file-text" /><span class="-visually-hidden">ノート</span>
					<span class="_tooltip" aria-hidden="true">ノート<kbd>N</kbd></span>
				</button>
			</li>
			<li>
				<button type="button" data-action="fullscreen" aria-keyshortcuts="F" aria-pressed="false">
					<Icon name="maximize" /><span class="-visually-hidden">全画面</span>
					<span class="_tooltip" aria-hidden="true">全画面<kbd>F</kbd></span>
				</button>
			</li>
			<li>
				<button type="button" data-action="presenter" aria-keyshortcuts="P">
					<Icon name="presentation" /><span class="-visually-hidden">発表者ビュー</span>
					<span class="_tooltip" aria-hidden="true">発表者ビュー<kbd>P</kbd></span>
				</button>
			</li>
			<li>
				<button type="button" data-action="theme" aria-keyshortcuts="D" aria-pressed="false">
					<Icon name="moon" /><span class="-visually-hidden">ダーク</span>
					<span class="_tooltip" aria-hidden="true">ダーク<kbd>D</kbd></span>
				</button>
			</li>
		</menu>
	</div>
</section>

<style>
	@layer components {
		.deck-controls {
			--_progress: var(--deck-controls--progress, 0);

			/* ツールチップを出す側。ボタンのツールチップがスタイルクエリで読む */
			--_tooltip-side: var(--deck-controls--tooltip-side, --block-end);

			/* 帯の内側の余白。ボタンの角丸も、帯の角丸からこの値を引いて求める（DESIGN.md の「操作の部分」） */
			--_band-padding: 0.25rem;

			/* ボタンの間。隙間は、両側のボタンが半分ずつ押せる範囲として持つ（pseudo-hit-area-no-overlap） */
			--_button-gap: 0.125rem;

			/* 組の間の線の太さ。線の上を押せる範囲として持つ、前の組の最後のボタンの計算にも使う */
			--_separator-width: 1px;

			/* ボタンの状態ごとの色（state-suffix-for-custom-properties）。値は DESIGN.md の「操作の部分」 */
			--_foreground: var(--foreground--muted);
			--_foreground--hocus: var(--foreground--base);
			--_foreground--pressed: var(--foreground--base);
			--_foreground--disabled: var(--foreground--disabled);

			/* ふだんは線を見せない。押した状態で線の色だけを変え、太さを変えずに済むよう、透明な線を置いておく */
			--_border-color: transparent;
			--_border-color--pressed: var(--border--base);
			--_background--pressed: var(--background--base);

			/* 帯の中のボタンを、ポインターかキーボードのフォーカスが指しているか（hocus-via-style-query） */
			--_has-hocus: --false;

			/* キーボードのフォーカスが帯の中のボタンにあるか。ハイライトとツールチップを動かさずに切り替えるのに使う */
			--_has-focus-visible: --false;

			/* ハイライト（::before）の包含ブロックにする */
			position: relative;

			/* 帯は 1 つだけだが、アンカーの名前がほかの部品に届かないよう、範囲を帯の中に限る（anchor-scope-for-repeated-components） */
			anchor-scope: --deck-controls-hocus;

			/*
			 * 帯の中に、ボタンの並びと、その下の進み具合の線を置く。
			 * 位置の表示（._position）は見えない文字で、ハイライト（::before）は絶対配置なので、並びに加わらない
			 */
			display: block grid;
			reading-flow: grid-rows;
			grid-template:
				'--buttons' auto
				'--progress-line' auto
				/ auto;
			padding: var(--_band-padding);
			border: 1px solid var(--border--base);
			border-radius: var(--rounded--control);
			background-color: var(--background--surface);
			font-family: var(--text--control--font-family);
			font-size: var(--text--control--font-size);
			font-weight: var(--text--control--font-weight);
			line-height: var(--text--control--leading);

			@media print {
				display: none;
			}

			/*
			 * data-idle はスクリプトが付ける（scripting-for-js-dependent-styles）。
			 * キーボードのフォーカスが中にある間は隠さない。:focus-within にすると、マウスで押したあとも隠れなくなる
			 * （focus-visible-over-focus-within）。
			 * 見えないボタンをタップで押してしまわないよう、隠れている間はポインターの操作を下のスライドに通す。
			 * タップの pointerdown でスクリプトが data-idle を外すので、次のタップからは押せる。
			 * ハイライトとツールチップは帯の中にあるので、帯と一緒に隠れる
			 */
			@media (scripting: enabled) {
				&[data-idle]:not(:has(> ._buttons :focus-visible)) {
					opacity: 0;
					pointer-events: none;
				}
			}

			/*
			 * 隠れる・現れる動きは、マウスの動きで起こるので、不透明度だけを動かす。
			 * 位置と大きさは変わらないので、動きを減らす設定でもそのまま残す（motion-only-with-no-preference）。
			 * キーボードのフォーカスが入って現れるときは、動かさずに一度で出す（no-motion-on-focus-visible）
			 */
			&:not(:has(> ._buttons :focus-visible)) {
				transition-duration: var(--duration--base);
				transition-property: opacity;
				transition-timing-function: var(--ease--out-quint);
			}

			/*
			 * ボタンの間の隙間と線の上は、ボタンの押せる範囲（::after）に含まれるので、ボタンのホバーとして数え、ハイライトを消さない。
			 * 無効のボタンにはハイライトを置かない
			 */
			&:has(> ._buttons button:enabled:not([aria-disabled='true']):hover) {
				@media (any-hover) {
					--_has-hocus: --true;
				}
			}

			&:has(> ._buttons button:enabled:not([aria-disabled='true']):focus-visible) {
				--_has-hocus: --true;
			}

			&:has(> ._buttons :focus-visible) {
				--_has-focus-visible: --true;
			}

			/*
			 * ホバーかフォーカスしたボタンの下に、1 枚の面を重ねる（anchor-indicator-as-decoration）。
			 * アンカーポジショニングに対応しない環境では描かず、ボタン自身のアイコンの色の変化だけで示す
			 */
			&::before {
				@supports (inset: anchor(inside)) {
					content: '';
					position: absolute;
					inset: anchor(inside);
					position-anchor: --deck-controls-hocus;

					/* 強制カラーモードでは、面の色が消える代わりに枠線に色が付く */
					border: 1px solid transparent;
					border-radius: calc(var(--rounded--control) - var(--_band-padding));
					background-color: var(--background--base);

					@container style(--_has-hocus: --false) {
						opacity: 0;
					}

					/* キーボードでフォーカスを移したときは、動かさずに一度で移す（no-motion-on-focus-visible） */
					@container style(--_has-focus-visible: --false) {
						transition-duration: var(--duration--base);
						transition-property: opacity;
						transition-timing-function: var(--ease--out-quint);
					}

					/* ボタンの間を滑らせるのは、動きを減らす設定がないときだけにする（motion-only-with-no-preference） */
					@container style(--_has-focus-visible: --false) and style(--_has-hocus: --true) {
						@media (prefers-reduced-motion: no-preference) {
							transition-property: inset, opacity;
							transition-timing-function: var(--ease--in-out-quint), var(--ease--out-quint);
						}
					}

					/*
					 * ポインターが帯を出たら、薄れ終わるまで最後のボタンの位置に留める。
					 * アンカーを失った inset は auto に戻るので、離散的な切り替えを step-end で時間の終わりまで遅らせる。
					 * allow-discrete はこの状態に入るときだけにし、帯の外から入ったときは、前の位置から滑らせずにその場に出す
					 */
					@container style(--_has-focus-visible: --false) and style(--_has-hocus: --false) {
						transition-property: inset, opacity;
						transition-timing-function: step-end, var(--ease--out-quint);
						transition-behavior: allow-discrete;
					}
				}
			}

			& > ._progress-line {
				grid-area: --progress-line;
			}

			& > ._buttons {
				grid-area: --buttons;
			}
		}

		/*
		 * 線の長さは割合の幅で決める。動かさないので、幅を変えても描き直しの負荷は問題にならず、
		 * transform の起点のような物理方向の指定も要らない。
		 * 線は背景ではなく枠線で描き、強制カラーモードでも見えるようにする
		 */
		._progress-line {
			inline-size: calc(100% * var(--_progress));
			border-block-start: 1px solid var(--accent--base);
		}

		/*
		 * ボタンは 6 つで、幅は約 15rem に決まっているので、1 行に収めて折り返さない。
		 * 折り返すと、組の間の線が折り返した行の頭に残るため。
		 * ハイライト（帯の ::before。帯の最初の子として描かれる）より後ろに描くよう、位置を指定した要素にする
		 * （木の順で重なりを決め、z-index を使わない）
		 */
		._buttons {
			position: relative;
			display: block flex;
		}

		/*
		 * 組の中のボタンは数が決まっていて、帯の 1 行に収まるので、折り返さない。
		 * ボタンの間の隙間は、両側のボタンの押せる範囲（::after）が半分ずつ覆うので、
		 * ポインターが隙間を通る間もどれかのボタンの上にある（pseudo-hit-area-no-overlap）
		 */
		menu {
			display: block flex;
			column-gap: var(--_button-gap);
		}

		li {
			/* 発表者ビューと縦に並べて読む形で隠すボタンの項目は、隙間だけが残らないよう、項目ごと並びから外す */
			&:has(> button[hidden]) {
				display: none;
			}

			/*
			 * 移動と表示の切り替えの組の間に、短い縦の細い線を引く（DESIGN.md の「操作の部分」）。
			 * 組は 2 つで、折り返さないので、前の組の最後の項目（次へ。隠すことはない）の擬似要素で描く（separators-in-gap の例外）。
			 * 押した状態の面が線に接しないよう、線の両側に帯の内側の余白と同じ間を取る
			 */
			&:last-child:is(menu:has(+ menu) > *) {
				display: block flex;
				column-gap: var(--_band-padding);
				align-items: center;
				padding-inline-end: var(--_band-padding);
			}

			&:last-child:is(menu:has(+ menu) > *)::after {
				content: '';
				block-size: 1rem;
				border-inline-start: var(--_separator-width) solid var(--border--base);
			}
		}

		button {
			/* 押せる部分の大きさ。文字と一緒に大きくし、CSS ピクセルの下限も併せて書く（hit-area-min-size） */
			--_hit-size: max(24px, 24 / 16 * 1rem);

			/*
			 * 枠線の太さ。押せる範囲（::after）はパディングボックスから測るので、広げる幅に足す。
			 * 足さないと、::after の端が枠線の外側の辺で止まり、隙間が覆われない
			 */
			--_border-width: 1px;

			/* 押せる範囲（::after）を、ボタンの外の行頭側と行末側へ広げる幅。ふだんは、どちらもボタンの間の半分 */
			--_hit-extend-inline-start: calc(var(--_button-gap) / 2);
			--_hit-extend-inline-end: calc(var(--_button-gap) / 2);

			/*
			 * ツールチップの左右の位置。ふだんはボタンの中央にそろえる。
			 * 動かさないので、中央に寄せる translate は描き直しの負荷にならない
			 */
			--_tooltip-inset-inline: 50% auto;
			--_tooltip-translate: -50% 0;

			/* ボタンを、ポインターかキーボードのフォーカスが指しているか。ツールチップが読む（hocus-via-style-query） */
			--_is-hocus: --false;
			--_is-focus-visible: --false;

			/* アイコンの大きさは、Icon の公開プロパティで渡す */
			--icon--size: 1.125rem;

			/* 強制カラーモードでは、アイコンの線をボタンの文字のシステムカラーにする（forced-colors-svg-system-colors） */
			--icon--forced-color: ButtonText;

			/* ツールチップの包含ブロックにする */
			position: relative;

			/*
			 * li の行の高さの分だけ、ボタンの上下に押せない隙間ができないよう、ブロックにする。
			 * アイコンを正方形の中央に置くため、グリッドにする
			 */
			display: block grid;
			place-items: center;
			inline-size: 2.25rem;
			min-inline-size: var(--_hit-size);
			min-block-size: var(--_hit-size);
			aspect-ratio: 1;

			/* 強制カラーモードでは線が見えるよう、none ではなく透明にする（色はルートの --_border-color） */
			border-width: var(--_border-width);
			border-color: var(--_border-color);

			/* 帯とボタンの角が同じ中心の円弧になるよう、帯の角丸から内側の余白を引く */
			border-radius: calc(var(--rounded--control) - var(--_band-padding));
			color: var(--_foreground);

			@media (any-pointer: coarse) {
				--_hit-size: max(44px, 44 / 16 * 1rem);
			}

			/*
			 * 押せる範囲を、見た目の面を変えずに、ボタンの間の隙間まで広げる（pseudo-hit-area-no-overlap）。
			 * 隣のボタンとは隙間の中央で接し、重ならない。ボタンの押せる範囲なので、隙間の上もボタンのホバーになる。
			 * ハイライトとツールチップは、ボタン自身の大きさと位置に合わせるので、広げた範囲の影響を受けない
			 */
			&::after {
				content: '';
				position: absolute;
				inset-block: 0;
				inset-inline: calc((var(--_border-width) + var(--_hit-extend-inline-start)) * -1)
					calc((var(--_border-width) + var(--_hit-extend-inline-end)) * -1);
			}

			/*
			 * 前の組の最後のボタン（次へ）は、組の間の線の両側の間と線の上まで押せる範囲を広げ、
			 * ポインターが線の上を通ってもハイライトを消さない。
			 * 後ろの組の最初に見えるボタンは、発表者ビューでノートを隠すと替わるので、どのボタンでも同じ行頭側の幅（ボタンの間の半分）のままにし、
			 * 次へがその残りを持つ。両方とも枠線の太さを足して測るので、2 つの範囲は重ならずに接する
			 */
			&:is(menu:has(+ menu) > li:last-child > *) {
				--_hit-extend-inline-end: calc(var(--_band-padding) * 2 + var(--_separator-width) - var(--_button-gap) / 2);
			}

			/* 押せないボタン（disabled、aria-disabled）は、ホバーで色を変えず、ハイライトも置かない */
			&:enabled:not([aria-disabled='true']):hover {
				@media (any-hover) {
					anchor-name: --deck-controls-hocus;
					color: var(--_foreground--hocus);
				}
			}

			/* ツールチップの名前は、押せないボタン（aria-disabled）にも出す */
			&:enabled:hover {
				@media (any-hover) {
					--_is-hocus: --true;
				}
			}

			/*
			 * ホバーで色が変わるときと、押している間だけ動かす。押した状態と無効の切り替えはキーでも起こるので、
			 * トランジションをふだんの状態に書かず、この状態に入るときにだけ効かせる。
			 * キーボードのフォーカスでは一度に切り替える（no-motion-on-focus-visible）
			 */
			&:enabled:not([aria-disabled='true'], :focus-visible):is(:hover, :active) {
				transition-duration: var(--duration--fast);
				transition-property: color;
