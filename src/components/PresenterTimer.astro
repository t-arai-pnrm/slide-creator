---
/**
 * 発表者ビューの経過時間と、その再生、一時停止、停止のボタン。src/scripts/deck.ts が、発表者ビューのときだけ hidden を外して動かす。
 * 経過時間は 1 秒ごとに変わるので、ライブリージョンにしない。読み上げが発表の間ずっと続くため。
 * 役割は timer にする。timer は既定で aria-live="off" なので、値が変わっても読み上げず、読みに来たときに今の値が分かる。
 *
 * 見える数字は桁ごとの帯（0 から 9 を縦に並べたもの）で、スクリプトが桁の値を --_value に書き、CSS が帯を動かす。
 * 帯の数字は読み上げると「0 1 2 …」と並んで意味をなさないので、aria-hidden で隠し、読み上げは見えない time の文字（「1 分 5 秒」）で伝える。
 * 「01:05」の形は時刻と区別しにくいので、読み上げの文字は分と秒を言葉で書く。
 *
 * 開いたときは止まった状態で 0 から始め、再生を押してから数える。発表の前に開いておき、話し始めに合わせて数え始めるため。
 * ボタンは操作の部分（DeckControls）と同じ形にする。アイコンだけを見せ、名前は見えない文字でボタンに持たせ、
 * 名前を読み上げないツールチップ（aria-hidden）で見せる。キーは割り当てないので、aria-keyshortcuts もツールチップの kbd も付けない。
 * 今の状態で押せないボタン（動いている間の再生など）は、スクリプトが aria-disabled="true" にする。
 * disabled にしないのは、押したボタンがそのまま押せない状態になる（再生を押すと再生が押せなくなる）ので、
 * disabled ではフォーカスがボタンから外れてしまうため。
 * ボタンの帯（._controls）の中の形（._buttons の中に menu）も DeckControls にそろえ、同じ見た目の帯にする。
 *
 * 文字は枠に比例させず、rem の control のスタイルで書く。面と線は、操作の部分（DeckControls）と同じ役割の色にする。
 * 置き場所（画面の上の端）は、置く側の Deck.astro が HTML の順で決める。
 */
import Icon from '@/components/Icon.astro'

/**
 * 表示する桁。分 2 桁と秒 2 桁で、スクリプトはこの順で桁を書く。
 * 99 分を超えたときの扱いは、src/scripts/deck.ts の桁を書くところにある
 */
const DIGIT_GROUPS = [2, 2] as const
const REEL = Array.from({ length: 10 }, (_, value) => value)
---

<div class="presenter-timer" hidden>
	<div class="_card" role="timer">
		<p class="_label">経過時間</p>
		<p class="_elapsed">
			<time class="-visually-hidden" datetime="PT0M0S">0 分 0 秒</time>
			<span class="_digits" aria-hidden="true">
				{DIGIT_GROUPS.map((digits, groupIndex) => (
					<>
						{groupIndex > 0 && <span class="_separator">:</span>}
						{Array.from({ length: digits }, () => <span class="_digit" style="--_value: 0" data-timer-digit>
							<span class="_reel">
								{REEL.map((value) => <span class="_reel-number">{value}</span>)}
							</span>
						</span>)}
					</>
				))}
			</span>
		</p>
	</div>
	<div class="_controls">
		<div class="_buttons">
			<menu aria-label="経過時間の操作">
				<li>
					<button type="button" data-action="timer-play">
						<Icon name="play" /><span class="-visually-hidden">再生</span>
						<span class="_tooltip" aria-hidden="true">再生</span>
					</button>
				</li>
				<li>
					<button type="button" data-action="timer-pause">
						<Icon name="pause" /><span class="-visually-hidden">一時停止</span>
						<span class="_tooltip" aria-hidden="true">一時停止</span>
					</button>
				</li>
				<li>
					<button type="button" data-action="timer-stop">
						<Icon name="square" /><span class="-visually-hidden">停止</span>
						<span class="_tooltip" aria-hidden="true">停止</span>
					</button>
				</li>
			</menu>
		</div>
	</div>
</div>

<style>
	@layer components {
		/*
		 * 経過時間のカードと、ボタンの帯を横に並べ、下端をそろえる。
		 * 1 行に入らないときは、帯をカードの下へ折り返し、間を上下左右とも 0.75rem 空ける（DESIGN.md の「タイマー」）
		 */
		.presenter-timer {
			/* ボタンの状態ごとの色（state-suffix-for-custom-properties）。値は DESIGN.md の「操作の部分」 */
			--_foreground: var(--foreground--muted);
			--_foreground--hocus: var(--foreground--base);
			--_foreground--disabled: var(--foreground--disabled);

			display: block flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			align-items: end;
			font-family: var(--text--control--font-family);
			font-size: var(--text--control--font-size);
			font-weight: var(--text--control--font-weight);
			line-height: var(--text--control--leading);

			/* 経過時間と離し、行の終わりに寄せる（flex-auto-margin-for-end-items） */
			& > ._controls {
				margin-inline-start: auto;
			}
		}

		/*
		 * ラベルの上に数字を積む。ラベルの文字は ._label 自身が text-box で刈るので、グリッドにしても刈り方は変わらない
		 * （gap-over-child-margin）
		 */
		._card {
			display: block grid;
			row-gap: 0.5rem;
			padding-block: 0.75rem;
			padding-inline: 1rem;
			border: 1px solid var(--border--base);
			border-radius: var(--rounded--control);
			background-color: var(--background--surface);
		}

		/* 大文字と字間の扱いは、スライドの中の label にそろえる（DESIGN.md の「タイマー」） */
		._label {
			color: var(--foreground--muted);
			text-box: trim-both;
			letter-spacing: var(--text--label--tracking);
			text-transform: uppercase;
		}

		._elapsed {
			font-family: var(--text--timer--font-family);
			font-size: var(--text--timer--font-size);
			font-weight: var(--text--timer--font-weight);

			/*
			 * 1 秒ごとに数字が替わっても、桁の窓の幅が揺れないようにする（tabular-nums-for-changing-numbers）。
			 * 等幅の書体を読み込めず、和文の書体の数字で出たときも同じ
			 */
			font-variant-numeric: tabular-nums;
			line-height: var(--text--timer--leading);
			letter-spacing: var(--text--timer--tracking);
		}

		/* マークアップの改行が空白の文字として入るので、グリッドで並べて空白を詰める */
		._digits {
			display: block grid;
			grid-auto-flow: column;
			justify-content: start;
		}

		._separator {
			color: var(--foreground--muted);
		}

		/* 1 字分の窓。帯の数字は 1 行に 1 字ずつ並ぶので、1 行の高さ（1lh）の窓に 1 字が入る。上下の端で隣の数字を切る */
		._digit {
			overflow: clip;
			block-size: 1lh;
		}

		/*
		 * 0 から 9 を縦に並べた帯。スクリプトが窓（._digit）に書いた桁の値（--_value）の分だけ上へ動かし、その数字を窓に出す。
		 * 位置が変わる動きなので、動きを減らす設定では動かさず、一度に替える（motion-only-with-no-preference）
		 */
		._reel {
			display: block grid;
			translate: 0 calc(var(--_value) * -1lh);

			@media (prefers-reduced-motion: no-preference) {
				transition-duration: var(--duration--slow);
				transition-property: translate;
				transition-timing-function: var(--ease--out-quint);
			}
		}

		/*
		 * ボタンの帯。帯、ボタン、ハイライト、ツールチップ、押している間の縮み、無効の見た目は、
		 * 操作の部分（DeckControls.astro）と同じ値と動きで書く（DESIGN.md の「タイマー」）。
		 * 同じ CSS は 2 か所だけなので、共通のスタイルにまとめず、それぞれのコンポーネントに書く（rule-of-three）。
		 * 値や動きを変えるときは、DeckControls.astro も同じように変える。
		 * 押した状態（aria-pressed）、組の間の線、キーの表示は、このボタンにはないので書かない
		 */
		._controls {
			/* 帯の内側の余白。ボタンの角丸も、帯の角丸からこの値を引いて求める（DESIGN.md の「操作の部分」） */
			--_band-padding: 0.25rem;

			/* ボタンの間。隙間は、両側のボタンが半分ずつ押せる範囲として持つ（pseudo-hit-area-no-overlap） */
			--_button-gap: 0.125rem;

			/* 帯の中のボタンを、ポインターかキーボードのフォーカスが指しているか（hocus-via-style-query） */
			--_has-hocus: --false;

			/* キーボードのフォーカスが帯の中のボタンにあるか。ハイライトとツールチップを動かさずに切り替えるのに使う */
			--_has-focus-visible: --false;

			/* ハイライトの包含ブロックにする */
			position: relative;

			/* アンカーの名前が帯の外に届かないよう、範囲を帯の中に限る（anchor-scope-for-repeated-components） */
			anchor-scope: --presenter-timer-hocus;
			padding: var(--_band-padding);
			border: 1px solid var(--border--base);
			border-radius: var(--rounded--control);
			background-color: var(--background--surface);

			/*
			 * ボタンの間の隙間の上は、ボタンの押せる範囲（::after）に含まれるので、ボタンのホバーとして数え、ハイライトを消さない。
			 * 無効のボタンにはハイライトを置かない
			 */
			&:has(> ._buttons button:enabled:not([aria-disabled='true']):hover) {
				@media (any-hover) {
					--_has-hocus: --true;
				}
			}

			&:has(> ._buttons button:enabled:not([aria-disabled='true']):focus-visible) {
				--_has-hocus: --true;
			}

			&:has(> ._buttons :focus-visible) {
				--_has-focus-visible: --true;
			}

			/*
			 * ホバーかフォーカスしたボタンの下に、1 枚の面を重ねる（anchor-indicator-as-decoration）。
			 * アンカーポジショニングに対応しない環境では描かず、ボタン自身のアイコンの色の変化だけで示す
			 */
			&::before {
				@supports (inset: anchor(inside)) {
					content: '';
					position: absolute;
					inset: anchor(inside);
					position-anchor: --presenter-timer-hocus;

					/* 強制カラーモードでは、面の色が消える代わりに枠線に色が付く */
					border: 1px solid transparent;
					border-radius: calc(var(--rounded--control) - var(--_band-padding));
					background-color: var(--background--base);

					@container style(--_has-hocus: --false) {
						opacity: 0;
					}

					/* キーボードでフォーカスを移したときは、動かさずに一度で移す（no-motion-on-focus-visible） */
					@container style(--_has-focus-visible: --false) {
						transition-duration: var(--duration--base);
						transition-property: opacity;
						transition-timing-function: var(--ease--out-quint);
					}

					/* ボタンの間を滑らせるのは、動きを減らす設定がないときだけにする（motion-only-with-no-preference） */
					@container style(--_has-focus-visible: --false) and style(--_has-hocus: --true) {
						@media (prefers-reduced-motion: no-preference) {
							transition-property: inset, opacity;
							transition-timing-function: var(--ease--in-out-quint), var(--ease--out-quint);
						}
					}

					/*
					 * ポインターが帯を出たら、薄れ終わるまで最後のボタンの位置に留める。
					 * アンカーを失った inset は auto に戻るので、離散的な切り替えを step-end で時間の終わりまで遅らせる。
					 * allow-discrete はこの状態に入るときだけにし、帯の外から入ったときは、前の位置から滑らせずにその場に出す
					 */
					@container style(--_has-focus-visible: --false) and style(--_has-hocus: --false) {
						transition-property: inset, opacity;
						transition-timing-function: step-end, var(--ease--out-quint);
						transition-behavior: allow-discrete;
					}
				}
			}
		}

		/*
		 * ハイライト（帯の ::before。帯の最初の子として描かれる）より後ろに描くよう、位置を指定した要素にする
		 * （木の順で重なりを決め、z-index を使わない）
		 */
		._buttons {
			position: relative;
		}

		/*
		 * ボタンは数が決まっていて、帯の 1 行に収まるので、折り返さない。
		 * ボタンの間の隙間は、両側のボタンの押せる範囲（::after）が半分ずつ覆うので、
		 * ポインターが隙間を通る間もどれかのボタンの上にある（pseudo-hit-area-no-overlap）
		 */
		menu {
			display: block flex;
			column-gap: var(--_button-gap);
		}

		/*
		 * 押せないボタンは、スクリプトが aria-disabled="true" にする。disabled と同じ見た目になるよう、両方をまとめて選ぶ（native-and-aria-state-together）。
		 * ホバーとフォーカスの見た目、ハイライト、押している間の縮みは、押せるボタンにだけ付ける
		 */
		button {
			/* 押せる部分の大きさ。文字と一緒に大きくし、CSS ピクセルの下限も併せて書く（hit-area-min-size） */
			--_hit-size: max(24px, 24 / 16 * 1rem);

			/*
			 * ツールチップの左右の位置。ふだんはボタンの中央にそろえる。
			 * 動かさないので、中央に寄せる translate は描き直しの負荷にならない
			 */
			--_tooltip-inset-inline: 50% auto;
			--_tooltip-translate: -50% 0;

			/* ボタンを、ポインターかキーボードのフォーカスが指しているか。ツールチップが読む（hocus-via-style-query） */
			--_is-hocus: --false;
			--_is-focus-visible: --false;

			/* アイコンの大きさは、Icon の公開プロパティで渡す */
			--icon--size: 1.125rem;

			/* 強制カラーモードでは、アイコンの線をボタンの文字のシステムカラーにする（forced-colors-svg-system-colors） */
			--icon--forced-color: ButtonText;

			/* ツールチップの包含ブロックにする */
			position: relative;

			/*
			 * li の行の高さの分だけ、ボタンの上下に押せない隙間ができないよう、ブロックにする。
			 * アイコンを正方形の中央に置くため、グリッドにする
			 */
			display: block grid;
			place-items: center;
			inline-size: 2.25rem;
			min-inline-size: var(--_hit-size);
			min-block-size: var(--_hit-size);
			aspect-ratio: 1;

			/* 強制カラーモードで線が見えるよう、none ではなく透明にする */
			border-color: transparent;

			/* 帯とボタンの角が同じ中心の円弧になるよう、帯の角丸から内側の余白を引く */
			border-radius: calc(var(--rounded--control) - var(--_band-padding));
			color: var(--_foreground);

			@media (any-pointer: coarse) {
				--_hit-size: max(44px, 44 / 16 * 1rem);
			}

			/*
			 * 押せる範囲を、見た目の面を変えずに、ボタンの間の隙間まで広げる（pseudo-hit-area-no-overlap）。
			 * 隣のボタンとは隙間の中央で接し、重ならない。ボタンの押せる範囲なので、隙間の上もボタンのホバーになる。
			 * ハイライトとツールチップは、ボタン自身の大きさと位置に合わせるので、広げた範囲の影響を受けない
			 */
			&::after {
				content: '';
				position: absolute;
				inset-block: 0;
				inset-inline: calc(var(--_button-gap) / -2);
			}

			/* 押せないボタンは、ホバーで色を変えず、ハイライトも置かない */
			&:enabled:not([aria-disabled='true']):hover {
				@media (any-hover) {
					anchor-name: --presenter-timer-hocus;
					color: var(--_foreground--hocus);
				}
			}

			/* ツールチップの名前は、押せないボタン（aria-disabled）にも出す */
			&:enabled:hover {
				@media (any-hover) {
					--_is-hocus: --true;
				}
			}

			/*
			 * ホバーで色が変わるときと、押している間だけ動かす。無効の切り替えはスクリプトが起こすので、
			 * トランジションをふだんの状態に書かず、この状態に入るときにだけ効かせる。
			 * キーボードのフォーカスでは一度に切り替える（no-motion-on-focus-visible）
			 */
			&:enabled:not([aria-disabled='true'], :focus-visible):is(:hover, :active) {
				transition-duration: var(--duration--fast);
				transition-property: color;
				transition-timing-function: var(--ease--hover);

				@media (prefers-reduced-motion: no-preference) {
					transition-property: color, scale;
					transition-timing-function: var(--ease--hover), var(--ease--out-quint);
				}
			}

			/* 押している間は縮め、押したことを返す。ハイライトはアンカーの配置の大きさのまま残る（press-feedback-short） */
			&:enabled:not([aria-disabled='true']):active {
				@media (prefers-reduced-motion: no-preference) {
					scale: 0.97;
				}
			}

			&:focus-visible {
				--_is-hocus: --true;
				--_is-focus-visible: --true;
			}

			/* ハイライトは、ホバーしているかキーボードのフォーカスがある、押せるボタンに重ねる */
			&:enabled:not([aria-disabled='true']):focus-visible {
				anchor-name: --presenter-timer-hocus;
				color: var(--_foreground--hocus);
			}

			/* 押せないことを示す見た目として、アイコンを補助の色の半分の不透明度にする（DESIGN.md の「操作の部分」） */
			&:is(:disabled, [aria-disabled='true']) {
				--icon--forced-color: GrayText;

				color: var(--_foreground--disabled);
			}

			/*
			 * 帯の右端のボタン（停止）だけは、画面の右端からはみ出さないよう、ツールチップの右端をボタンの右端にそろえる。
			 * 帯は横書きで並ぶので、右端は行の終わり（inline-end）になる
			 */
			&:is(li:last-child > *) {
				--_tooltip-inset-inline: auto 0;
				--_tooltip-translate: none;
			}

			/*
			 * ツールチップは、ボタンの中央の下に出す。帯は画面の上の端にあるので、上ではなく下に出す。
			 * ボタンを包含ブロックにした絶対配置で置き、アンカーポジショニングに対応しない環境でも同じ位置に出す
			 * （no-unsupported-layout-features）
			 */
			& > ._tooltip {
				position: absolute;
				inset-inline: var(--_tooltip-inset-inline);
				inset-block-start: calc(100% + 0.375rem);
				translate: var(--_tooltip-translate);
			}
		}

		/* ツールチップの上にポインターが来ても、ボタンのホバーとして扱わない */
		._tooltip {
			inline-size: max-content;
			padding-block: 0.25rem;
			padding-inline: 0.5rem;
			border: 1px solid var(--border--base);
			border-radius: 0.5rem;
			background-color: var(--background--surface);
			color: var(--foreground--base);
			opacity: 0;
			text-box: trim-both;
			pointer-events: none;

			@container style(--_is-hocus: --true) {
				opacity: 1;
			}

			/* 現れる・消える変化は不透明度だけなので、動きを減らす設定でも残す。キーボードのフォーカスでは一度に出す（no-motion-on-focus-visible） */
			@container style(--_is-focus-visible: --false) {
				transition-duration: var(--duration--base);
				transition-property: opacity;
				transition-timing-function: var(--ease--out-quint);
			}
		}
	}
</style>
